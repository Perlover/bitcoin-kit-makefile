#!/bin/bash

. $HOME/.bitcoin_envs

service_name=bitcoind
bitcoin_network=mainnet
pid_file=$HOME/.${bitcoin_network}-${service_name}.pid
tcp_port=8333

systemd_unit=${service_name}@${bitcoin_network}.service

# If this bitcoind is managed by systemd, stop it the systemd way: the unit
# waits for the daemon to really finish its shutdown, marks itself cleanly
# inactive and handles the UPnP teardown. Falls through to the legacy path
# on hosts without systemd or when bitcoind was launched by the wrapper.
if command -v systemctl >/dev/null 2>&1 && \
   systemctl --user is-active --quiet "$systemd_unit"; then
    echo -n "The ${service_name} (${bitcoin_network}) is systemd-managed, stopping via 'systemctl --user stop $systemd_unit' ..."
    if systemctl --user stop "$systemd_unit"; then
	echo " OK"
	exit 0
    else
	echo " ERROR: systemctl stop failed, falling back to the bitcoin-cli path"
    fi
fi

if [ ! -f $pid_file ]; then
    echo "ERROR: The ${service_name} (${bitcoin_network}) not run!"
    exit 1
fi

if [ "$$BITCOIN_KIT_UPNP_SUPPORT$$" == "Yes" ]; then
    echo -n "UPnP Off (${service_name}/${bitcoin_network}) ..."
    {
	upnpc -m $$BITCOIN_KIT_LOCAL_IP$$ -d ${tcp_port} tcp
    } &> /dev/null && echo " OK" || echo " ERROR: i cannot delete port redirection [$?] (upnpc -d ${tcp_port} tcp)"
fi

pid=`cat $pid_file`

bitcoin-cli -conf=$HOME/.bitcoin/bitcoin-${bitcoin_network}.conf stop

echo -n "The ${service_name} (${bitcoin_network}) terminating ..."
# `bitcoin-cli stop` only *asks* the daemon to stop. Flushing the chainstate
# and the block index can take minutes on a big node - wait for it.
for i in {1..600}; do
    kill -0 $pid &>/dev/null || break
    echo -n '.'
    sleep 1
done
kill -0 $pid &>/dev/null && echo "I cannot terminate ${service_name} (${bitcoin_network})" && exit 2
echo " OK"
