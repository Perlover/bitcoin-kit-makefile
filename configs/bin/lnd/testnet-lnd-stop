#!/bin/bash

. $HOME/.bitcoin_envs
. $HOME/.golang_envs

bitcoin_network=testnet
tcp_port=9736
service_name=lnd
pid_file=$HOME/.${bitcoin_network}-${service_name}.pid
macaroon_path=$HOME/.lnd/data/chain/bitcoin/${bitcoin_network}/admin.macaroon
grpc_port=10010
systemd_unit=${service_name}@${bitcoin_network}.service

# If this lnd is managed by systemd, stop it the systemd way. Killing the
# process by pid out from under an active unit would leave the unit's state
# desynced and, with `Restart=on-failure`, could even resurrect lnd 30s
# later. `systemctl stop` marks the unit cleanly inactive and suppresses the
# restart. The unit's own ExecStopPost handles `lncli stop`, SIGTERM, the
# UPnP teardown and pid-file removal, so we just delegate and exit.
# Falls through to the legacy pid/kill path on hosts without systemd
# (e.g. old CentOS) or when lnd was launched by the wrapper, not the unit.
if command -v systemctl >/dev/null 2>&1 && \
   systemctl --user is-active --quiet "$systemd_unit"; then
    echo -n "The ${service_name} (${bitcoin_network}) is systemd-managed, stopping via 'systemctl --user stop $systemd_unit' ..."
    if systemctl --user stop "$systemd_unit"; then
	echo " OK"
	rm -f $pid_file
	exit 0
    else
	echo " ERROR: systemctl stop failed, falling back to the pid/kill path"
    fi
fi

if [ ! -f $pid_file ]; then
    echo "ERROR: The ${service_name} (${bitcoin_network}) not run!"
    exit 1
fi

if [ "$$BITCOIN_KIT_UPNP_SUPPORT$$" == "Yes" ]; then
    echo -n "UPnP Off (${service_name}/${bitcoin_network}) ..."
    {
	upnpc -m $$BITCOIN_KIT_LOCAL_IP$$ -d ${tcp_port} tcp
    } &> /dev/null && echo " OK" || echo " ERROR: i cannot delete port redirection [$?] (upnpc -d ${tcp_port} tcp)"
fi

echo -n "The ${service_name} (${bitcoin_network}) terminating ..."

# First way - to try stop through `lncli stop` command but sometime it hangs up a long time
lncli --macaroonpath ${macaroon_path} --rpcserver localhost:${grpc_port} stop &
lncli_pid=$!

for i in {1..60}; do
    kill -0 `cat $pid_file` &>/dev/null || break
    echo -n '.'
    sleep 1
done

if kill -0 `cat $pid_file` &>/dev/null; then
    # If we here - the lnd works...
    kill $lncli_pid &>/dev/null
    kill `cat $pid_file` &>/dev/null
    for i in {1..5}; do
	kill -0 `cat $pid_file` &>/dev/null || break
	echo -n '.'
	sleep 1
    done
    kill -0 `cat $pid_file` &>/dev/null && echo "I cannot terminate ${service_name} (${bitcoin_network})" && exit 2
fi

echo " OK"
rm -f $pid_file
